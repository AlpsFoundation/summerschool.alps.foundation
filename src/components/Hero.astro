---
// What the 2026 cohort said, in place of the edition/dates/location row
// (Matthias, 2026-09-06). The week is over, so how it landed is the more
// useful opening fact; the dates and the venue are still stated in the
// paragraph above and in the Venue section.
//
// Source: the anonymous post-event feedback form, 13 responses. The first
// version of the form used a five-point scale, so those answers are doubled
// onto the ten-point scale before averaging. Recompute if replies come in.
const ratings = [
  { value: '9.5 / 10', label: 'Average experience rating' },
  { value: '9.7 / 10', label: 'Would recommend to a friend' },
  { value: '100%', label: 'Rated the week 8 or higher' },
];
---

<section
  id="top"
  class="relative -mt-[var(--nav-h)] grid grid-cols-1 grid-rows-[42.1875vw_auto] items-start overflow-hidden pb-[clamp(3rem,6vw,5rem)] pt-[calc(var(--nav-h)+clamp(1.5rem,5vw,3rem))] lg:grid-rows-[31.640625vw_auto] lg:pt-[var(--nav-h)]"
>
  <div
    class="absolute inset-x-0 top-0 z-0 aspect-[16/9] overflow-hidden lg:aspect-[1600/675]"
    aria-hidden="true"
  >
    <img
      src="/assets/hero-banner.png"
      alt=""
      width="1600"
      height="900"
      fetchpriority="high"
      class="block h-auto w-full lg:-translate-y-[25%]"
    />
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 top-[1px] z-0 aspect-[16/9] bg-[linear-gradient(to_bottom,rgba(5,0,7,0)_67%,rgba(5,0,7,0.7)_84%,var(--color-bg)_100%)] lg:aspect-[1600/675]"
    aria-hidden="true"
  ></div>

  <!-- Reserves 75% of the banner image height so the title appears just below its lower quarter -->
  <div class="pointer-events-none min-h-0 shrink-0" aria-hidden="true"></div>

  <div class="container-x relative z-10 row-start-2 max-w-[900px] self-start">
    <span class="eyebrow">ALPS Summer School · 26 Jul – 01 Aug 2026</span>

    <h1
      class="mt-6 font-medium tracking-[-0.03em]"
    >
      Exploring the Peaks of{' '}
      <span class="grad-text">Psychedelic Science</span>{' '}
      &amp; Therapy
    </h1>

    <p
      class="mb-9 max-w-[640px] text-[clamp(1.05rem,1.6vw,1.25rem)] text-white/85"
    >
      An immersive week of lectures, hands-on workshops and community with
      leading psychedelic researchers — the 2026 edition wrapped on 1 August
      at Le Camp, above Lake Neuchâtel. Thank you to everyone who made it
      what it was.
    </p>

    {/* CTA buttons removed 2026-08-30: the participant-space link lives in
        Philosophy & practical details, and 2027 is now its own page reached
        from the nav rather than a card on this one. */}

    {/* Value above label: the number is what the eye should land on, so it
        comes first visually and `order` puts the <dt> back underneath without
        breaking the definition-list semantics. */}
    <dl class="gradient-border grid max-w-[720px] grid-cols-1 gap-px sm:grid-cols-3">
      {
        ratings.map((r) => (
          <div class="flex flex-col gap-1 bg-[#08030c] px-[1.2rem] py-[1.1rem]">
            <dd class="grad-text order-1 m-0 text-[1.5rem] font-semibold tracking-[-0.02em]">
              {r.value}
            </dd>
            <dt
              class="order-2 text-[0.72rem] font-medium uppercase tracking-[0.14em] text-[var(--color-fg-subtle)]"
            >
              {r.label}
            </dt>
          </div>
        ))
      }
    </dl>
    <p class="m-0 mt-3 text-[0.72rem] text-[var(--color-fg-subtle)]">
      Anonymous post-event survey, 13 responses. Five-point answers scaled to ten.
    </p>
  </div>
</section>
