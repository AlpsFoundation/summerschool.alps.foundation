---
// 2026 cohort — names appear here ONLY with the person's explicit written
// consent (email replies to summerschool@, tracked in the ALPS Assistant
// project doc "ass26-post-event-website-grill-ledger-2026-08-27").
// "First name only" entries are listed by first name, at the person's request.
// Alphabetical. The 2025 alumni list lives on /recap-2025.

const team = [
  {
    name: 'Andrea Bacconi',
    role: 'Participant experience, workshop and social program',
    image: '/assets/people-andrea.jpg',
  },
  { name: 'Ece Baloglu', role: 'Communication', image: '/assets/people-ece.jpg' },
  {
    name: 'Ana Mateea Cerchez',
    role: 'Communication, kitchen assistant',
    image: '/assets/people-mateea.jpg',
  },
  { name: 'Lennert van de Kreeke', role: 'Project advisor', image: '/assets/people-lennert.jpg' },
  {
    name: 'Matthias Leitner',
    role: 'Project coordination, venue',
    image: '/assets/people-matthias.jpg',
  },
  {
    name: 'Morten Lietz',
    role: 'Planning advisor, decoration, kitchen support',
    image: '/assets/people-morten.jpg',
  },
  {
    name: 'Régis Paroz',
    role: 'Decoration, art',
    image: '/assets/people-regis.jpg',
  },
  { name: 'Raphael Saunier', role: 'Web development', image: '/assets/people-raph.jpg' },
  { name: 'Alex Wester', role: 'Chef', image: '/assets/people-alex.jpg' },
  {
    name: 'Parsa Yousefi',
    role: 'Scientific, workshop and social program',
    image: '/assets/people-parsa.jpg',
  },
];
---

<section id="people" class="py-[clamp(4rem,8vw,7rem)]">
  <div class="container-x">
    <div class="mb-[clamp(2rem,4vw,3rem)] flex max-w-[820px] flex-col gap-4">
      <span class="eyebrow self-start">Team</span>
      <h2>The team behind the week.</h2>
      <p>
        A small volunteer team plans the programme, runs the days on site and
        keeps the Summer School affordable. The 2026 cohort itself is listed
        <a href="/#alumni-2026" class="underline decoration-white/30 underline-offset-2 hover:text-white">with the recap above</a>.
      </p>
    </div>

    <div>
      <ul
        class="m-0 grid list-none grid-cols-1 gap-4 p-0 lg:grid-cols-2"
      >
        {
          team.map((p) => (
            <li class="card grid h-full grid-cols-[120px_1fr] overflow-hidden !p-0 sm:grid-cols-[150px_1fr]">
              <img
                src={p.image}
                alt={p.name}
                class="aspect-[3/4] h-full w-full object-cover"
                loading="lazy"
              />
              <div class="flex min-w-0 flex-col justify-center gap-[0.25rem] p-5">
                <span class="font-medium text-white">{p.name}</span>
                <span class="text-[0.82rem] text-[var(--color-fg-subtle)]">
                  {p.role}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
