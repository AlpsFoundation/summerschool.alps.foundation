---
// ASS27 teaser + interest-list sign-up (blue/orange 2027 accent).
// Dates are provisional until the Le Camp rental contract is signed.
// Submissions go to /api/interest -> D1 "ass27-interest" (binding ASS27_DB).
const facts = [
  { label: 'Dates', value: '8 – 13 Aug 2027*' },
  { label: 'Location', value: 'Le Camp, Vaumarcus' },
  { label: 'Format', value: 'Residential week' },
  { label: 'Language', value: 'English' },
];
---

<section id="interest-2027" class="py-[clamp(3rem,6vw,5rem)]">
  <div class="container-x">
    <div class="gradient-border gradient-border--2027 overflow-hidden rounded-[var(--radius-xl)]">
      <div class="flex flex-col gap-7 bg-[#070a10] px-[clamp(1.5rem,4vw,3rem)] py-[clamp(2rem,4vw,3rem)]">
        <div class="flex max-w-[720px] flex-col gap-3">
          <span class="eyebrow self-start !text-[#ffb066]">Summer School 2027</span>
          <h2 class="m-0 text-[clamp(1.5rem,3vw,2.25rem)]">
            The <span class="grad-text-2027">third edition</span> is coming.
          </h2>
          <p class="m-0 text-white/85">
            Same lake, same mountains: we are planning the 2027 week at
            Le Camp. Join the interest list and you will hear from us first
            when applications open &mdash; before we announce anything
            publicly.
          </p>
        </div>

        <form
          data-interest-form
          class="flex max-w-[720px] flex-col gap-3 sm:flex-row sm:items-end"
          novalidate
        >
          <label class="flex flex-1 flex-col gap-1 text-[0.78rem] font-medium uppercase tracking-[0.12em] text-[var(--color-fg-subtle)]">
            Name
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              placeholder="Jane Doe"
              class="rounded-[var(--radius-md)] border border-[rgba(90,167,232,0.35)] bg-white/[0.04] px-4 py-3 text-[0.95rem] normal-case tracking-normal text-white placeholder:text-white/30 focus:border-[#5aa7e8] focus:outline-none"
            />
          </label>
          <label class="flex flex-1 flex-col gap-1 text-[0.78rem] font-medium uppercase tracking-[0.12em] text-[var(--color-fg-subtle)]">
            Email
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="jane@example.org"
              class="rounded-[var(--radius-md)] border border-[rgba(90,167,232,0.35)] bg-white/[0.04] px-4 py-3 text-[0.95rem] normal-case tracking-normal text-white placeholder:text-white/30 focus:border-[#5aa7e8] focus:outline-none"
            />
          </label>
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
          <button type="submit" class="btn btn--2027 sm:shrink-0">
            Join the 2027 interest list
          </button>
        </form>
        <p data-interest-msg hidden class="m-0 text-[0.92rem]"></p>

        <dl class="grid max-w-[720px] grid-cols-2 gap-x-8 gap-y-4 sm:grid-cols-4">
          {
            facts.map((f) => (
              <div class="flex flex-col gap-1">
                <dt class="text-[0.72rem] font-medium uppercase tracking-[0.14em] text-[#5aa7e8]">
                  {f.label}
                </dt>
                <dd class="m-0 text-[0.98rem] font-medium text-white">{f.value}</dd>
              </div>
            ))
          }
        </dl>

        <p class="m-0 text-[0.78rem] text-[var(--color-fg-subtle)]">
          *Dates are provisional until the venue booking is finalised. We only
          use your details to contact you about the Summer School.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-interest-form]');
  const msg = document.querySelector<HTMLElement>('[data-interest-msg]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const btn = form.querySelector('button');
    if (btn) btn.disabled = true;
    try {
      const res = await fetch('/api/interest', {
        method: 'POST',
        body: new FormData(form),
      });
      const data = await res.json().catch(() => ({ ok: false }));
      if (msg) {
        msg.hidden = false;
        if (data.ok) {
          msg.textContent = 'You are on the list — we will write to you before applications open. See you at Le Camp!';
          msg.style.color = '#ffb066';
          form.hidden = true;
        } else {
          msg.textContent = data.error || 'Something went wrong — please email summerschool@alps.foundation instead.';
          msg.style.color = '#f87171';
          if (btn) btn.disabled = false;
        }
      }
    } catch {
      if (msg) {
        msg.hidden = false;
        msg.textContent = 'Something went wrong — please email summerschool@alps.foundation instead.';
        msg.style.color = '#f87171';
      }
      if (btn) btn.disabled = false;
    }
  });
</script>
