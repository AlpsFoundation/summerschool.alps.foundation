      `Serge Weydert is a neuroscientist and serial entrepreneur. He has founded and sold two health-tech start-ups — one in <mark>neurorehabilitation</mark> and another in the wearable space, <mark>training parasympathetic activity through biofeedback and breathwork</mark>. He is now Chief Product and Technology Officer at <strong>Aeon</strong>, a preventive-healthcare company, and is privately engaged in supporting psychedelic research.`,
    ],
  },
  {
    id: 'speaker-parsa-yousefi',
    name: 'Parsa Yousefi',
    title: 'PhD candidate',
    affiliations: ['University of Fribourg', 'ALPS Foundation'],
    image: '/assets/speakers-parsa-yousefi.jpg',
    bio: [
      `Parsa Yousefi is a doctoral researcher at the <strong>Molecular Psychiatry Lab, University of Fribourg</strong>, working under Prof. Gregor Hasler. His research investigates <mark>altered states of consciousness, psychedelics, bodily self-consciousness, and interoception</mark>, combining neuroimaging, EEG, virtual reality, and respiratory physiology. His current project, <mark>HYPERSELF</mark>, is a multimodal study of how hyperventilation-induced altered states reshape bodily self-experience.`,
      `Alongside his PhD, Parsa contributes to research at the <strong>ALPS Foundation</strong> and coordinates the educational programme of the ALPS Summer School.`,
    ],
  },
];

const speakerId: Record<string, string> = Object.fromEntries(
  speakers.map((s) => [s.name, s.id]),
);

// First timetable slot where each speaker appears -> anchor id, so bios can link back to the programme.
const speakerSlot: Record<string, string> = {};
schedule.forEach((day) =>
  day.sessions.forEach((s, i) => {
    const names = s.speaker ? [s.speaker] : (s.panelists ?? []);
    names.forEach((nm) => {
      const id = speakerId[nm];
      if (id && !(id in speakerSlot)) speakerSlot[id] = `slot-d${day.num}-${i}`;
    });
  }),
);

const kindLabel: Record<string, string> = {
  workshop: 'Workshop',
  panel: 'Panel',
  social: 'Social',
  opening: 'Opening',
  closing: 'Closing',
};

// Official websites for the affiliation badges (reviewed 2026-06-02).
const affiliationUrl: Record<string, string> = {
  'University of Zurich': 'https://www.uzh.ch/en.html',
  'University of Basel': 'https://www.unibas.ch/en.html',
  'University Hospital Basel': 'https://www.unispital-basel.ch/en/',
  'University of Fribourg': 'https://www.unifr.ch/home/en/',
  'University of Freiburg': 'https://uni-freiburg.de/en/',
  'University Hospital of Psychiatry Zurich': 'https://www.pukzh.ch/',
  'ZI Mannheim': 'https://www.zi-mannheim.de/en.html',
  'MIND Foundation': 'https://mind-foundation.org/',
  'Ernst Strüngmann Institute': 'https://www.esi-frankfurt.de/',
  'Max Planck Society': 'https://www.mpg.de/en',
  'Catholic University, Milan': 'https://www.unicatt.it/en.html',
  'Reconnect Labs': 'https://reconnect-labs.com/',
  'Aeon': 'https://aeon.life/',
  'ALPS Foundation': 'https://alps.foundation/',
};

import SpeakerBio from './SpeakerBio.astro';
// NOTE: session rows deliberately carry NO photos (Matthias, 2026-09-03) —
// the photo/programme link runs one way only, from a gallery caption to its
// session row. The row ids below are what those captions target.

// Speakers merged into the programme 2026-08-30: every bio now lives inside the
// session it belongs to. A speaker with no scheduled slot (guest facilitator,
// late change) would otherwise vanish, so they are listed after the schedule.
const speakerById: Record<string, Speaker> = Object.fromEntries(
  speakers.map((s) => [s.id, s])
);
const unscheduled = speakers.filter((s) => !speakerSlot[s.id]);
---

<section id="program" class="py-[clamp(4rem,8vw,7rem)]">
  <div class="container-x">
    <div class="mb-[clamp(2rem,4vw,3rem)] flex max-w-[820px] flex-col gap-4">
      <span class="eyebrow self-start">Programme &amp; speakers</span>
      <h2>Six days, six themes — one cohesive journey.</h2>
      <p>
        Each full day of the ALPS Summer School 2026 pairs three morning
        lectures with an afternoon workshop and an evening gathering. The full
        day-by-day programme is below &mdash; <strong>open any session to read
        who led it</strong>, with their affiliations and background.
      </p>
    </div>

    {/* Wraps the toggle + full schedule so the toggle can stick to the
        viewport for exactly the height of the day-by-day list below, then
        release once the schedule ends (position: sticky is bound to this
        wrapper as its containing block). */}
    <div class="relative">
      <div
        class="sticky z-20 mt-6 flex justify-end sm:mt-8"
        style="top: calc(var(--nav-h) + 0.75rem)"
      >
        <label class="inline-flex w-fit shrink-0 cursor-pointer items-center gap-3 rounded-full border border-[var(--color-border-strong)] bg-[rgba(5,0,7,0.75)] px-4 py-[0.6rem] backdrop-blur-xl backdrop-saturate-[1.4] transition-colors supports-[backdrop-filter]:bg-[rgba(5,0,7,0.55)] hover:border-[var(--color-accent)]">
        <span class="relative inline-flex h-[1.4rem] w-[2.6rem] flex-shrink-0 items-center">
          <input type="checkbox" id="lo-toggle" class="peer absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 rounded-full bg-[var(--color-border-strong)] transition-colors duration-200 peer-checked:bg-[var(--color-accent)]"
          />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute left-[3px] h-[1.05rem] w-[1.05rem] rounded-full bg-white transition-transform duration-200 peer-checked:translate-x-[1.2rem]"
          />
        </span>
          <span class="text-[0.85rem] font-medium text-white">Show learning objectives</span>
        </label>
      </div>

      {/* Full day-by-day timetable. Each day is its own CSS grid: the marker
          in the left column, that day's sessions in the right. The marker is
          sticky, so it holds while its own sessions scroll past and hands over
          at the next day — which is why the grid is PER DAY and not one grid
          for the week. A single grid with `display: contents` day groups would
          make the whole week each marker's containing block, and day 2's
          marker would ride down over day 3. */}
      <div class="mt-6">
      {
        schedule.map((day) => (
          <div id={`day-${day.num}`} class="day scroll-mt-24">
            <div class="day__marker">
              <span class="day__num grad-text">
                {String(day.num).padStart(2, '0')}
              </span>
              <span class="day__date">{day.date.replace(/^(\w{3})\w*/, '$1')}</span>
              <h3 class="day__theme">{day.theme}</h3>
            </div>

            <div class="day__sessions flex flex-col">
              {day.sessions.map((s, i) => {
                const slotId = `slot-d${day.num}-${i}`;
                const sid = s.speaker ? speakerId[s.speaker] : undefined;
                const isLink = Boolean(sid);
                // Not every co-facilitator has a speaker bio card (e.g. a guest not
                // featured in the Speakers section) — keep them in the list but skip
                // the link when there's no matching id.
                const panelists = (s.panelists ?? [])
                  .map((nm) => ({ name: nm, id: speakerId[nm] }));
                const meta = s.kind === 'meta';
                const tba = s.kind === 'tba';
                const label = s.kind ? kindLabel[s.kind] : undefined;
                const who = tba ? 'To be announced' : (s.speaker ?? s.title);
                const topic = tba ? 'To be announced.' : s.topic;
                // The row border lives on the OUTER wrapper (details/div) so
                // `first:border-t-0` still measures position within the day —
                // a <summary> is always its <details>'s first child.
                const base =
                  'session-row grid grid-cols-[7.5rem_1fr] gap-x-5 gap-y-1 py-3 sm:grid-cols-[8rem_13rem_1fr]';
                const rowEdge = 'border-t border-[var(--color-border)] first:border-t-0';
                const whoCls =
                  (meta || tba
                    ? 'text-[0.95rem] font-medium text-[var(--color-fg-subtle)]'
                    : 'text-[0.98rem] font-semibold text-white') + (tba ? ' italic' : '');
                const topicCls =
                  'col-span-2 text-[0.9rem] leading-[1.5] sm:col-span-1 ' +
                  (meta || tba ? 'text-[var(--color-fg-subtle)]' : 'text-[var(--color-fg-muted)]') +
                  (tba ? ' italic' : '');

                const objectives = s.learningObjectives ?? [];
                const objectivesBlock = objectives.length > 0 && (
                  <div data-lo class="col-span-2 mt-2 max-w-[36rem] sm:col-span-1 sm:col-start-3">
                    <span class="mb-1 block text-[0.62rem] uppercase tracking-[0.14em] text-[var(--color-accent)]">
                      Learning objectives
                    </span>
                    <ul class="m-0 grid list-none gap-1 p-0 text-[0.82rem] leading-[1.45] text-[var(--color-fg-subtle)]">
                      {objectives.map((lo) => (
                        <li>{lo}</li>
                      ))}
                    </ul>
                  </div>
                );

                // Bios shown inline under the row: the lead speaker plus any
                // co-facilitators who have one.
                const bioIds = [
                  ...(sid ? [sid] : []),
                  ...panelists.map((p) => p.id).filter(Boolean),
                ] as string[];
                const bios = bioIds.map((id) => speakerById[id]).filter(Boolean);

                const rowInner = (
                  <Fragment>
                    <span class="pt-[2px] font-mono text-[0.78rem] whitespace-nowrap text-[var(--color-fg-subtle)]">
                      {s.time}
                    </span>
                    <span class={whoCls}>
                      {label && (
                        <span class="mb-[2px] block text-[0.62rem] uppercase tracking-[0.14em] text-[var(--color-accent)]">
                          {label}
                        </span>
                      )}
                      {panelists.length
                        ? panelists.map((p, i) => (
                            <Fragment>
                              {i > 0 ? ' & ' : ''}
                              {p.name}
                            </Fragment>
                          ))
                        : who}
                      {bios.length > 0 && (
                        <span
                          aria-hidden="true"
                          class="slot-chev ml-1.5 inline-block text-[var(--color-accent)] transition-transform duration-200"
                        >
                          ›
                        </span>
                      )}
                    </span>
                    {topic ? <span class={topicCls}>{topic}</span> : <span class="hidden sm:block" />}
                    {objectivesBlock}
                  </Fragment>
                );

                return bios.length > 0 ? (
                  <details id={slotId} class={`session-details scroll-mt-24 ${rowEdge}`}>
                    <summary
                      class={`session-summary -mx-3 cursor-pointer rounded-[var(--radius-sm)] px-3 transition-colors hover:bg-[rgba(154,0,109,0.12)] ${base}`}
                    >
                      {rowInner}
                    </summary>
                    <div class="mb-4 mt-1 flex flex-col gap-3 sm:pl-[8rem]">
                      {bios.map((sp) => (
                        <SpeakerBio speaker={sp} affiliationUrl={affiliationUrl} />
                      ))}
                    </div>
                  </details>
                ) : (
                  <div id={slotId} class={`scroll-mt-24 ${rowEdge} ${base}`}>
                    {rowInner}
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
      </div>
    </div>


    {/* Speakers are merged into the schedule above (2026-08-30). This keeps
        the old /#speakers anchor landing here, and catches any speaker who has
        no scheduled slot so their bio never silently disappears. */}
    <div id="speakers" class="scroll-mt-24">
      {unscheduled.length > 0 && (
        <div class="mt-[clamp(3rem,6vw,5rem)]">
          <div class="mb-6 flex flex-col gap-3 border-b border-[var(--color-border)] pb-4">
            <span class="eyebrow self-start">Also with us</span>
            <h3 class="m-0 text-[clamp(1.4rem,2.6vw,1.9rem)]">
              Facilitators beyond the timetable
            </h3>
          </div>
          <div class="flex flex-col gap-4">
            {unscheduled.map((sp) => (
              <SpeakerBio speaker={sp} affiliationUrl={affiliationUrl} />
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  // The recap gallery links a photo's caption to its session row
  // (`#slot-d<day>-<index>`). A plain anchor scrolls a <details> into view but
  // leaves it shut, so open the target — on load and on every later hash
  // change — then re-scroll, since opening changes the layout.
  const openTarget = () => {
    const id = location.hash.slice(1);
    if (!id.startsWith('slot-')) return;
    const el = document.getElementById(id);
    if (!(el instanceof HTMLDetailsElement)) return;
    el.open = true;
    requestAnimationFrame(() => el.scrollIntoView({ block: 'start' }));
  };
  window.addEventListener('hashchange', openTarget);
  openTarget();
</script>

<style>
  /* --- Day rail (2026-09-03) ------------------------------------------------
     The six cards that used to announce the days are gone: they duplicated
     the day headers below them, they only ever covered six of the seven days,
     and nothing but the cards themselves linked to #day-N. In their place the
     day marker moved out of the content column into the margin, where it
     sticks for exactly the length of its own day. The week stays one
     continuous, searchable scroll and every #slot-dN-M anchor is untouched. */

  #program .day {
    display: grid;
    grid-template-columns: 1fr;
  }

  /* A day boundary, drawn as a fading rule across both columns. Painted as a
     background on the day's own padding box so it needs no extra element and
     no pseudo-element (a ::before here would become a grid item). */
  #program .day + .day {
    margin-top: clamp(1.6rem, 3vw, 2.5rem);
    padding-top: clamp(1.6rem, 3vw, 2.5rem);
    background-image: linear-gradient(
      90deg,
      rgba(154, 0, 109, 0.9) 0%,
      rgba(255, 79, 181, 0.5) 45%,
      rgba(255, 255, 255, 0.06) 100%
    );
    background-repeat: no-repeat;
    background-size: 100% 2px;
    background-position: 0 0;
  }

  #program .day__marker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }

  #program .day__num {
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  #program .day__date {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-fg-subtle);
  }

  #program .day__theme {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 500;
    color: #fff;
  }

  /* From here up the marker leaves the flow and becomes the sticky rail.
     820px is where 12.5rem can be spared from the session columns without
     squeezing the topic text. */
  @media (min-width: 820px) {
    #program .day {
      grid-template-columns: 12.5rem 1fr;
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    #program .day__marker {
      position: sticky;
      /* Clears the site header; the learning-objectives switch sticks at the
         same height but is right-aligned, so the two never meet. */
      top: calc(var(--nav-h) + 0.75rem);
      align-self: start;
      display: block;
      padding: 0.2rem 0 0;
      margin: 0;
      border-bottom: 0;
    }

    #program .day__num {
      display: block;
      font-size: clamp(2.4rem, 4.4vw, 3.5rem);
      line-height: 0.9;
      letter-spacing: -0.05em;
    }

    #program .day__date {
      display: block;
      margin-top: 0.5rem;
    }

    #program .day__theme {
      margin-top: 0.3rem;
      font-size: 1rem;
      text-wrap: balance;
    }

    #program .day__sessions {
      padding-bottom: 0.4rem;
    }
  }

  /* Sessions with a speaker expand in place to reveal that speaker's bio
     (Programme + Speakers merged 2026-08-30). No JS: native <details>. */
  #program .session-summary {
    list-style: none;
  }
  #program .session-summary::-webkit-details-marker {
    display: none;
  }
  #program .session-details[open] .slot-chev {
    transform: rotate(90deg);
  }
  #program .session-summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    #program .slot-chev {
      transition: none;
    }
  }

  /* Global learning-objectives visibility, driven by the #lo-toggle switch
     in the Program section header. No JS: a single :has() rule reveals
     every [data-lo] block (each sits under its session's topic column). */
  #program [data-lo] {
    display: none;
  }

  #program:has(#lo-toggle:checked) [data-lo] {
    display: block;
  }
</style>
