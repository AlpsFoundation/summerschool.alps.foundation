---
// The 2026 cohort, directly under the photo strip.
//
// TWENTY-ONE slots, one per participant, so the real size of the week is
// visible. What each slot shows depends only on what that person agreed to
// (Matthias, 2026-09-06 — "publish the ones who replied the way they desired,
// and the others we keep foggy"):
//
//   * the 10 who replied to the 2026-08-27 email appear exactly as they asked
//     — full name, or first name only where that was the request;
//   * the other 11 never replied, and that email promised "no reply means no
//     listing", so their slots carry nothing at all. They are rendered fogged:
//     a blurred placeholder that is not derived from anyone's name.
//
// The fog is decorative, not redacted text — there is no name in the DOM to
// recover. Do not "improve" this by blurring real names with CSS: a filter is
// a paint effect, the text would still sit in the markup for anyone who reads
// the source, and initials in a cohort of 21 are often resolvable to a person.
//
// Consent record: ALPS Assistant project doc
// "ass26-post-event-website-grill-ledger-2026-08-27".
const consented = [
  'Anne Ala-Pöntiö',
  'Claire Prudent',
  'Elie',
  'Giuseppe Vacca',
  'Juan Romero',
  'Olga Rabei',
  'Riccardo Lamberti',
  'Robin Grylka',
  'Sofía López',
  'Swapnamoy Roy',
];

const COHORT = 21;
const withheld = COHORT - consented.length;

// Varied widths so the fogged slots read as different people rather than a
// repeated tile. Deterministic, and deliberately not tied to any real name.
const fogWidths = ['58%', '72%', '46%', '65%', '80%', '52%', '69%', '43%', '75%', '61%', '55%'];
---

<section id="alumni-2026" class="pb-[clamp(2rem,4vw,3rem)]">
  <div class="container-x">
    <div
      class="mb-6 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 border-b border-[var(--color-border)] pb-4"
    >
      <div class="flex items-baseline gap-4">
        <span class="eyebrow">Alumni 2026</span>
        <h2 class="m-0 text-[1.1rem] font-medium tracking-[0.02em]">
          The people who shared the week
        </h2>
      </div>
      <span class="text-[0.8rem] uppercase tracking-[0.1em] text-[var(--color-fg-subtle)]">
        {COHORT} participants &middot; {consented.length} named
      </span>
    </div>

    <ul
      class="m-0 grid list-none gap-2 p-0"
      style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));"
    >
      {
        consented.map((name) => (
          <li class="flex items-center gap-[0.9rem] rounded-full border border-[var(--color-border)] bg-white/[0.025] px-4 py-3 transition-all duration-200 hover:border-[var(--color-border-strong)] hover:bg-[rgba(154,0,109,0.1)]">
            <span
              aria-hidden="true"
              class="grad-primary h-[7px] w-[7px] flex-shrink-0 rounded-full"
            />
            <span class="text-[0.9rem] font-normal text-white/90">{name}</span>
          </li>
        ))
      }
      {
        Array.from({ length: withheld }).map((_, i) => (
          <li class="flex items-center gap-[0.9rem] rounded-full border border-dashed border-[var(--color-border)] bg-white/[0.012] px-4 py-3">
            <span
              aria-hidden="true"
              class="h-[7px] w-[7px] flex-shrink-0 rounded-full bg-white/20"
            />
            <span class="fog" aria-hidden="true" style={`width:${fogWidths[i % fogWidths.length]}`} />
            <span class="sr-only">Participant who has not asked to be named</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-4 text-[0.8rem] text-[var(--color-fg-subtle)]">
      Twenty-one people shared the week. A name appears here only where that
      person has asked for it &mdash; the rest stay deliberately unreadable.
      Were you there in 2026 and would like to be named, or taken off? Write to
      <a
        href="mailto:summerschool@alps.foundation"
        class="underline decoration-white/30 underline-offset-2 hover:text-white"
      >summerschool@alps.foundation</a>. Alumni of the first edition are on the
      <a
        href="/recap-2025"
        class="underline decoration-white/30 underline-offset-2 hover:text-white"
      >2025 recap page</a>.
    </p>
  </div>
</section>

<style>
  /* A blurred smear standing in for a name nobody has agreed to publish.
     Pure paint: a soft gradient bar, blurred — there is no text underneath,
     so there is nothing to read out of the markup or un-blur. */
  #alumni-2026 .fog {
    display: block;
    height: 0.62rem;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.34) 0%,
      rgba(255, 255, 255, 0.14) 38%,
      rgba(255, 79, 181, 0.26) 62%,
      rgba(255, 255, 255, 0.22) 100%
    );
    filter: blur(3.5px);
  }
</style>
