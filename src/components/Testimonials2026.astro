---
// 2026 recap: survey stats + a self-scrolling, infinitely-looping gallery
// interleaving ASS 2026 photos with quotes from the anonymous post-event
// feedback survey.
//
// Which photos run here, and which session each belongs to, come from
// src/data/gallery-2026.ts — Matthias's review in the ASS26 Photo Review
// tool (2026-09-03: 216 reviewed, 141 excluded, 75 kept). Do not add or
// remove photos by hand here; change the review and regenerate the data.
import {
  photos as galleryPhotos,
  photoSrc,
  photoAlt,
  eventLabel,
  eventSlot,
} from '../data/gallery-2026';

const photos = galleryPhotos.map((p) => ({
  src: photoSrc(p),
  alt: photoAlt(p),
  event: eventLabel(p),
  slot: eventSlot(p),
}));

const quotes = [
  'A place to feel kindly accepted while mentally stimulated.',
  'Top edge academic value combined with practical insight and networking.',
  'Finding oneself through community.',
  'Community, visionary, scientific, integrative, humanitarian.',
  'Exploring the field of psychedelics from diverse, carefully curated perspectives through high-quality content and speakers, in a highly organized, professional and welcoming environment.',
  'The ALPS Summer School is an immersive learning experience, where you get to be part of a movement that is striving to change the world in a better, more humane way.',
  'Food for the soul.',
  'It was so precious to witness the progressive relaxing, letting go and healing of the students during the week.',
  'Thank you for such an intensive, inspiring, communal, heart-warming and motivating week.',
  'Thank you so much for making me feel visible again.',
  'It’s hard to see any room for improvement after such an amazing week.',
  'The most special moment? All of us, together, in this container.',
  'The dedication of the team to track wishes and possible problems during the week, and their motivation to immediately take action.',
  'We are ants, and this was an ant-ropological study.',
];

// Survey stat tiles. Source: anonymous ASS26 feedback form, 13 responses;
// the first form version used 5-point answers — scaled x2 to the 10-point
// scale before averaging. Recompute when new responses arrive.
// "What is the Summer School?" was merged into this recap on 2026-08-30 —
// the week itself now answers the question, illustrated with 2026 photos.
const pillars = [
  {
    title: 'Expert-led lectures',
    body: 'Renowned psychedelic researchers deliver daily talks and guide group discussions on current science.',
    image: '/assets/gallery-2026/p084_lecture-hall-audience-wide.jpg',
    alt: 'A lecture in the main hall at the ALPS Summer School 2026',
  },
  {
    title: 'Hands-on workshops',
    body: 'Experienced facilitators lead interactive workshops blending theory with practical skills and reflection.',
    image: '/assets/gallery-2026/p060_outdoor-craft-amphitheater.jpg',
    alt: 'Hands-on craft session in the outdoor amphitheatre, 2026',
  },
  {
    title: 'Community & nature',
    body: 'Evenings and breaks unfold in forest, under the stars and overlooking Lake Neuchâtel — in a small cohort of 25–30.',
    image: '/assets/gallery-2026/p119_pergola-group-lakeview.jpg',
    alt: 'The 2026 cohort in the pergola, overlooking Lake Neuchâtel',
  },
];

const stats = [
  { value: '9.5 / 10', label: 'Average experience rating' },
  { value: '9.7 / 10', label: 'Would recommend to a friend' },
  { value: '100%', label: 'Rated the week 8 or higher' },
];

// Interleave: one quote after every third photo.
type Slide =
  | {
      type: 'photo';
      src: string;
      alt: string;
      event: string | null;
      slot: string | null;
    }
  | { type: 'quote'; text: string };
const slides: Slide[] = [];
let q = 0;
photos.forEach((p, i) => {
  slides.push({ type: 'photo', ...p });
  if ((i + 1) % 3 === 0 && q < quotes.length) {
    slides.push({ type: 'quote', text: quotes[q++] });
  }
});
while (q < quotes.length) slides.push({ type: 'quote', text: quotes[q++] });
---

<section id="recap-2026" class="py-[clamp(3rem,6vw,5rem)]">
  <div class="container-x">
    <div class="mb-[clamp(2rem,4vw,3rem)] flex max-w-[820px] flex-col gap-4">
      <span class="eyebrow self-start">What is the Summer School?</span>
      <h2>
        An immersive week of{' '}
        <span class="grad-text">psychedelic science</span>, therapy
        and personal growth.
      </h2>
      <p>
        The ALPS Summer School is an educational program focused on
        <strong> psychedelic science</strong> &mdash; offering a holistic
        opportunity for both <strong>professional and personal development</strong>.
        Renowned researchers deliver lectures and lead discussions; experienced
        facilitators guide <strong>interactive workshops</strong>; engaging social
        events complement the experience &mdash; all in close proximity to nature.
      </p>
      <p>
        The second edition ran from 26 July to 1 August 2026 at Le Camp. Here is
        what that week looked like, in the words and pictures of the people who
        were there.
      </p>
    </div>

    <div class="mb-[clamp(2.5rem,5vw,4rem)] grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        pillars.map((c) => (
          <article class="card flex flex-col overflow-hidden !p-0">
            <img
              src={c.image}
              alt={c.alt}
              loading="lazy"
              class="aspect-[4/3] w-full shrink-0 object-cover"
            />
            <div class="flex flex-col gap-3 p-[clamp(1.25rem,2.5vw,2rem)]">
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div
      class="mb-[clamp(1.5rem,3vw,2.5rem)] flex flex-wrap items-end justify-between gap-4"
    >
      <div class="flex max-w-[680px] flex-col gap-3">
        <span class="eyebrow self-start">Moments &amp; voices from 2026</span>
        <h2 class="text-[clamp(1.5rem,3vw,2.25rem)]">
          A glimpse of this year&rsquo;s week, in pictures and words.
        </h2>
        <p class="m-0 text-[0.92rem] text-[var(--color-fg-subtle)]">
          Photos from the week and quotes from our anonymous participant
          feedback survey. It scrolls by itself &mdash; drag or swipe to
          explore at your own pace, and tap a photo&rsquo;s caption to jump
          to that session in the programme. Looking for last year?
          <a href="/recap-2025" class="underline decoration-white/30 underline-offset-2 hover:text-white">Relive 2025 here</a>.
        </p>
      </div>

      <div class="hidden items-center gap-2 md:flex">
        <button
          type="button"
          data-gallery-prev
          aria-label="Previous"
          class="grid h-10 w-10 place-items-center rounded-full border border-[var(--color-border-strong)] bg-white/[0.03] text-white transition-colors hover:bg-[rgba(154,0,109,0.18)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button
          type="button"
          data-gallery-next
          aria-label="Next"
          class="grid h-10 w-10 place-items-center rounded-full border border-[var(--color-border-strong)] bg-white/[0.03] text-white transition-colors hover:bg-[rgba(154,0,109,0.18)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <dl class="mb-[clamp(1.5rem,3vw,2.5rem)] grid max-w-[720px] grid-cols-1 gap-px sm:grid-cols-3 gradient-border">
      {
        stats.map((s) => (
          <div class="flex flex-col gap-1 bg-[#08030c] px-[1.2rem] py-[1.1rem]">
            <dd class="m-0 order-1 text-[1.5rem] font-semibold tracking-[-0.02em] grad-text">
              {s.value}
            </dd>
            <dt class="order-2 text-[0.72rem] font-medium uppercase tracking-[0.14em] text-[var(--color-fg-subtle)]">
              {s.label}
            </dt>
          </div>
        ))
      }
    </dl>
    <p class="mb-0 -mt-[clamp(1rem,2vw,1.8rem)] text-[0.72rem] text-[var(--color-fg-subtle)]">
      Anonymous post-event survey, 13 responses. Five-point answers scaled to ten.
    </p>
  </div>

  <div
    data-gallery-track
    class="mt-[clamp(1.5rem,3vw,2.5rem)] flex gap-3 overflow-x-auto px-[max(1rem,calc((100%-1200px)/2+1rem))] pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    style="-webkit-overflow-scrolling: touch;"
  >
    {
      slides.map((s) =>
        s.type === 'photo' ? (
          <figure class="group relative m-0 h-[clamp(280px,36vh,380px)] shrink-0 overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg-elev)]">
            <img
              src={s.src}
              height="480"
              alt={s.alt}
              loading="lazy"
              decoding="async"
              class="h-full w-auto max-w-none object-cover"
            />
            {
              s.event && (
                <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/45 to-transparent px-3 pb-2 pt-8">
                  {s.slot ? (
                    <a
                      href={`#${s.slot}`}
                      class="slot-jump pointer-events-auto inline-flex max-w-full items-center gap-1.5 text-[0.7rem] leading-tight text-white/85 transition-colors hover:text-white"
                    >
                      <span class="truncate">{s.event}</span>
                      <span aria-hidden="true" class="text-[var(--color-accent)]">&rsaquo;</span>
                    </a>
                  ) : (
                    <span class="block truncate text-[0.7rem] leading-tight text-white/70">
                      {s.event}
                    </span>
                  )}
                </figcaption>
              )
            }
          </figure>
        ) : (
          <figure class="card m-0 flex h-[clamp(280px,36vh,380px)] w-[clamp(250px,64vw,320px)] shrink-0 flex-col justify-between gap-3 overflow-hidden">
            <blockquote class="m-0 min-h-0 overflow-hidden">
              <span aria-hidden="true" class="grad-text mb-1 block text-[1.8rem] font-semibold leading-none">
                &ldquo;
              </span>
              <p class="m-0 text-[0.85rem] leading-[1.5] text-white/90">{s.text}</p>
            </blockquote>
            <figcaption class="flex items-center gap-[0.6rem] text-[0.68rem] uppercase tracking-[0.12em] text-[var(--color-fg-subtle)]">
              <span aria-hidden="true" class="grad-primary h-[6px] w-[6px] flex-shrink-0 rounded-full" />
              2026 participant
            </figcaption>
          </figure>
        )
      )
    }
  </div>

  <div class="container-x mt-4">
    <p
      class="swipe-hint m-0 flex items-center justify-center gap-2 text-[0.72rem] uppercase tracking-[0.16em] text-[var(--color-fg-subtle)] md:hidden"
      aria-hidden="true"
    >
      <svg class="swipe-hint__l" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Swipe to explore
      <svg class="swipe-hint__r" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </p>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-gallery-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-gallery-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-gallery-next]');

  if (track) {
    // Seamless loop: originals as the middle copy, one identical copy each side.
    const originals = Array.from(track.children);
    const N = originals.length;
    for (let c = 0; c < 2; c++) {
      originals.forEach((node) => {
        const clone = node.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.querySelectorAll('img').forEach((img) => img.setAttribute('loading', 'lazy'));
        track.appendChild(clone);
      });
    }

    let setWidth = 0;
    const measure = () => {
      const a = track.children[0] as HTMLElement;
      const b = track.children[N] as HTMLElement;
      setWidth = b.offsetLeft - a.offsetLeft;
    };
    const recenter = () => {
      if (setWidth > 0) track.scrollLeft = setWidth;
    };
    measure();
    recenter();
    window.addEventListener('load', () => {
      const x = track.scrollLeft;
      measure();
      if (Math.abs(x - setWidth) < 4) recenter();
    });

    let raf = 0;
    track.addEventListener(
      'scroll',
      () => {
        if (raf || setWidth <= 0) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const x = track.scrollLeft;
          if (x < setWidth * 0.5) track.scrollLeft = x + setWidth;
          else if (x > setWidth * 1.5) track.scrollLeft = x - setWidth;
        });
      },
      { passive: true }
    );
    window.addEventListener('resize', () => measure());

    const step = () => Math.round(track.clientWidth * 0.8);
    prev?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));

    // Drag-to-scroll for pointer devices.
    let down = false, startX = 0, startScroll = 0, moved = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;
      down = true; moved = false;
      startX = e.clientX; startScroll = track.scrollLeft;
    });
    track.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      track.scrollLeft = startScroll - dx;
    });
    const end = () => { down = false; };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointerleave', end);
    track.addEventListener('click', (e) => { if (moved) e.preventDefault(); }, true);
    track.querySelectorAll('img').forEach((img) =>
      img.addEventListener('dragstart', (e) => e.preventDefault())
    );

    // Autoplay: slow continuous scroll; pauses on hover/touch/drag and when
    // the tab is hidden; respects prefers-reduced-motion.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced) {
      let paused = false;
      let resumeTimer = 0;
      const pause = () => { paused = true; window.clearTimeout(resumeTimer); };
      const resumeSoon = () => {
        window.clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => { paused = false; }, 2500);
      };
      track.addEventListener('pointerenter', pause);
      track.addEventListener('pointerleave', resumeSoon);
      track.addEventListener('pointerdown', pause);
      track.addEventListener('pointerup', resumeSoon);
      track.addEventListener('touchstart', pause, { passive: true });
      track.addEventListener('touchend', resumeSoon);
      let carry = 0;
      const tick = () => {
        if (!paused && !document.hidden && setWidth > 0) {
          carry += 0.6;
          const px = Math.floor(carry);
          if (px > 0) { track.scrollLeft += px; carry -= px; }
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  [data-gallery-track] { cursor: grab; }
  [data-gallery-track]:active { cursor: grabbing; }
  .swipe-hint__l { animation: swipe-hint-l 1.8s ease-in-out infinite; }
  .swipe-hint__r { animation: swipe-hint-r 1.8s ease-in-out infinite; }
  @keyframes swipe-hint-l {
    0%, 100% { transform: translateX(0); opacity: 0.55; }
    50% { transform: translateX(-3px); opacity: 1; }
  }
  @keyframes swipe-hint-r {
    0%, 100% { transform: translateX(0); opacity: 0.55; }
    50% { transform: translateX(3px); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .swipe-hint__l, .swipe-hint__r { animation: none; }
  }
</style>
